in vec3 position;
in vec2 texcoord;
in vec4 color;

uniform highp mat4 modelMatrix;
uniform highp mat4 viewMatrix;
uniform highp mat4 projMatrix;
// the node of the model that the sprite hangs on, and the place of the sprite in it
uniform highp mat4 extraMatrix;
uniform highp vec3 spritePos;
uniform highp vec2 spriteSize;

struct shadow_info {
	UBOOL _active;
	vec3 _color;
	vec3 _light;
	vec3 _point;
	vec3 _normal;
};

uniform shadow_info shadow;

out vec2 Texcoord;
out vec4 Color;
out float ClipDist;

// A sprite of Grim is a quad that always faces the camera (smoke, sparks): its bottom edge stands on the position of the sprite and the corners
// are put around that point in the plane of the view.
void main() {
	vec4 anchor = modelMatrix * extraMatrix * vec4(spritePos, 1.0);
	vec4 viewPos = viewMatrix * anchor;
	viewPos.xy += position.xy * spriteSize;
	gl_Position = projMatrix * viewPos;

	ClipDist = 1.0;
	if (UBOOL_TEST(shadow._active)) {
		Color = vec4(shadow._color, 1.0);
	} else {
		Color = color;
	}
	Texcoord = texcoord;
}
