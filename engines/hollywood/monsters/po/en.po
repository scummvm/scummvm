msgid "stage401-large.559"
msgstr "Hey, buddy!"

msgid "stage401-large.560"
msgstr "My name is Hecker, Dr. Markus Hecker."

msgid "stage401-large.561"
msgstr "PhD in Occult Sciences from the University of Cologne."

msgid "stage401-large.562"
msgstr "Dr. Hecker!"

msgid "stage401-large.563"
msgstr "Yes?"

msgid "stage401-large.564"
msgstr "About the medallion you mentioned ..."

msgid "stage401-large.565"
msgstr "Yes, what do you want to know?"

msgid "stage401-large.566"
msgstr "Where is your beloved now?"

msgid "stage401-large.567"
