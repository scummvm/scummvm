msgid "stage102-large.524"
msgstr "I think I should use those two levers here."

msgid "stage102-large.525"
msgstr "They must be full of wine."

msgid "stage102-large.526"
msgstr "I don't need it at all, it's quite useless."

msgid "stage102-large.527"
msgstr "It's a broken tape recorder, same model as mine ..."

msgid "stage102-large.528"
msgstr "... it's definitely Sue's!"

msgid "stage102-large.529"
msgstr "I wonder what it's doing here and why it's broken."

