msgstr " entrance"

msgid "stage211-small.2"
msgstr " Award"

msgid "stage211-small.3"
msgstr " base of the Award"

msgid "stage211-small.4"
msgstr " treasure"

msgid "stage211-large.500"
msgstr "There's more than enough here for me AND everybody at The Quill to enjoy an early retirement!"

msgid "stage211-large.501"
msgstr "It communicates with the Mummy's office."

msgid "stage211-large.502"
msgstr "No expense was spared."

msgid "stage211-large.503"
msgstr "“Best Dramatic Role - Academy Of Motion Picture Arts And Sciences”"

msgid "stage211-large.504"
msgstr "I'd love to ..."

msgid "stage211-large.505"
msgstr "So much money!"

msgid "stage211-large.506"
msgstr "It's really impressive!"

msgid "stage211-large.507"
msgstr "I fought hard to get that role in “The Curse of the Nile”."

msgid "stage211-large.508"
msgstr "Do you know that the producer wanted me to perform my role stiff and expressionless like Frankenstein?"

msgid "stage211-large.509"
msgstr "Well, many people think that Frankenstein and you look a lot alike physically."

msgid "stage211-large.510"
msgstr "“Many people” ..."

msgid "stage211-large.511"
msgstr "... “many people” ..."

msgid "stage211-large.512"
msgstr "What do they know?!"

msgid "stage211-large.513"
msgstr "Those “many people” probably couldn't even distinguish Dr. Jekyll and Mr. Hyde, even if they saw their names written on their foreheads."

