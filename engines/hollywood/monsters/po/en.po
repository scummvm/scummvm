msgid "stage306-large.518"
msgstr "It can't be rotated manually. I should have to use the buttons on its base."

msgid "stage306-large.519"
msgstr "It's a simple button."

msgid "stage306-large.520"
msgstr "Aha! ..."

msgid "stage306-large.521"
msgstr "... a secret door! ..."

msgid "stage306-large.522"
msgstr "... I'd bet anything that it leads to the secret laboratory of Dr. Frankenstein."

msgid "stage306-large.523"
