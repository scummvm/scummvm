msgstr "... I'd bet they're empty."

msgid "stage709-large.510"
msgstr "Very appropriate!"

msgid "stage709-large.511"
msgstr "Empty."

msgid "stage709-large.512"
msgstr "Nice figure."

msgid "stage709-large.513"
msgstr "I can't think of any use for it."

msgid "stage709-large.514"
msgstr "Great idea! ..."

msgid "stage709-large.515"
msgstr "... I'll place it in front of the window."

msgid "stage709-large.516"
msgstr "Ready!"

msgid "stage709-large.517"
msgstr "I'd better leave it where it is."

