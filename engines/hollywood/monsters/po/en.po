msgid "stage602-large.515"
msgstr "Yes, of course it's mine. I forgot it last time I was here for a meeting with Mr. Hannover."

msgid "stage602-large.516"
msgstr "Lucky for you, you finally got it back, right?"

msgid "stage602-large.517"
msgstr "Very lucky, indeed."

msgid "stage602-large.518"
msgstr "It's full of dust. It's been here for along time."

msgid "stage602-large.519"
msgstr "You like my handbag ...?"

