msgid "stage102-large.520"
msgstr "It connects the hook to the mechanical pulley."

msgid "stage102-large.521"
msgstr "I'm afraid I'm not strong enough."

msgid "stage102-large.522"
msgstr "It's not necessary."

msgid "stage102-large.523"
