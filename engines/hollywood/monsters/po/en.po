msgid "stage401-large.535"
msgstr "No doubt this is the correct place! I'll note the address on my agenda."

msgid "stage401-large.536"
msgstr "It's the one the Count threw out the window."

msgid "stage401-large.537"
msgstr "Young man, young man! ...\t"

msgid "stage401-large.538"
