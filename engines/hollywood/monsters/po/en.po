msgid "stage401-large.569"
msgstr "If only I knew that she still remembers me ..."

msgid "stage401-large.570"
msgstr "Why don't you forget your past and start a new life? You are still young."

msgid "stage401-large.571"
msgstr "Never! You don't know who you're talking about."

msgid "stage401-large.572"
