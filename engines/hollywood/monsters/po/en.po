msgid "stage203-large.566"
msgstr "What do you take me for? My prices aren't open to bargain."

msgid "stage203-large.567"
msgstr "All my products are top quality, effendi."

msgid "stage203-large.568"
msgstr "Okay, I'll take it."

msgid "stage203-large.569"
msgstr "A great purchase, effendi. You'll not regret it."

msgid "stage203-large.570"
msgstr "I'll have to think about it."

